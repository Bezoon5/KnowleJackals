rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'beswick1985@yahoo.com';
    }
    function isCoach() {
      return signedIn() && (isOwner() ||
        myEmail() in get(/databases/$(database)/documents/config/coaches).data.emails);
    }
    match /config/coaches {
      allow read: if true;
      allow write: if isOwner();
    }
    match /club/{doc} {
      allow read: if true;
      allow write: if isCoach();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if isCoach();
    }
  }
}
